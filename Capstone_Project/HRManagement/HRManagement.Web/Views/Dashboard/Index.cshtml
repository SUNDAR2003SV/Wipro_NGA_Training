@using System.Security.Claims

<h2>HR Management Dashboard</h2>

<hr />

<h4>
    Welcome
    @User.Identity?.Name
</h4>

<h5>
    Role:
    @User.FindFirst(ClaimTypes.Role)?.Value
</h5>

<hr />

@if (User.IsInRole("Admin"))
{
    <div>

        <h4>Admin Features</h4>

        <a asp-controller="Employee"
               asp-action="Index"
               class="btn btn-primary">
            Manage Employees
        </a>

        <br /><br />

        <a asp-controller="Leave"
               asp-action="Approval"
               class="btn btn-warning">
            Manage Leaves
        </a>

        <br /><br />

        <a asp-controller="Analytics"
               asp-action="Index"
               class="btn btn-success">
            Analytics
        </a>

        <br /><br />

        <a asp-controller="AuditLog"
               asp-action="Index"
               class="btn btn-dark">
            Audit Logs
        </a>

    </div>
}

@if (User.IsInRole("HR"))
{
    <div>

        <h4>HR Features</h4>

        <a asp-controller="Employee"
               asp-action="Index"
               class="btn btn-primary">
            Employee Management
        </a>

        <br /><br />

        <a asp-controller="Leave"
               asp-action="Approval"
               class="btn btn-warning">
            Leave Approval
        </a>

        <br /><br />

        <a asp-controller="Analytics"
               asp-action="Index"
               class="btn btn-success">
            Analytics
        </a>

    </div>
}

@if (User.IsInRole("Manager"))
{
    <div>
        <h4>Manager Features</h4>

        <li>
            <a asp-controller="Leave"
                   asp-action="Approval">
                Leave Approval
            </a>
        </li>
    </div>
}

@if (User.IsInRole("Employee"))
{
    <div>
        <h4>Employee Features</h4>

        <ul>
            <li>
                <a asp-controller="Leave"
                       asp-action="Apply">
                    Apply Leave
                </a>
            </li>

            <li>
                <a asp-controller="Leave"
                       asp-action="MyLeaves">
                    View Leave Status
                </a>
            </li>
        </ul>
    </div>
}

<hr />

<a asp-controller="Account"
       asp-action="Logout"
       class="btn btn-danger">
    Logout
</a>