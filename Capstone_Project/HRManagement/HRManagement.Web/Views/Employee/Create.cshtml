@model HRManagement.Core.Entities.Employee

<h2>Add Employee</h2>

<form asp-action="Create">

    <div>
        <label>First Name</label>

        <input asp-for="FirstName"
               class="form-control" />

        <span asp-validation-for="FirstName"></span>
    </div>

    <div>
        <label>Email</label>

        <input asp-for="Email"
               class="form-control" />

        <span asp-validation-for="Email"></span>
    </div>

    <button type="submit">
        Save
    </button>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}