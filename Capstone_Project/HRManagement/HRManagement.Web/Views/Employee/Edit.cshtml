@model HRManagement.Core.Entities.Employee

<h2>Edit Employee</h2>

<hr />

<form asp-action="Edit">

    <input type="hidden"
           asp-for="EmployeeId" />

    <div class="mb-3">

        <label asp-for="FirstName"
               class="form-label">
        </label>

        <input asp-for="FirstName"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label asp-for="LastName"
               class="form-label">
        </label>

        <input asp-for="LastName"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label asp-for="Email"
               class="form-label">
        </label>

        <input asp-for="Email"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label asp-for="Department"
               class="form-label">
        </label>

        <input asp-for="Department"
               class="form-control" />

    </div>

    <button type="submit"
            class="btn btn-primary">
        Save Changes
    </button>

    <a asp-action="Index"
           class="btn btn-secondary">
        Cancel
    </a>

</form>