@model HRManagement.Core.Entities.Leave

<h2>Apply Leave</h2>

<form asp-action="Apply" method="post">

    <div class="mb-3">
        <label>Employee Id</label>
        <input asp-for="EmployeeId" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Start Date</label>
        <input asp-for="StartDate"
               type="date"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>End Date</label>
        <input asp-for="EndDate"
               type="date"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Reason</label>
        <textarea asp-for="Reason"
                  class="form-control"></textarea>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Apply Leave
    </button>

</form>