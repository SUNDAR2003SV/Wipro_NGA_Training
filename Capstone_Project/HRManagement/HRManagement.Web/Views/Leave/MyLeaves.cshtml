@model IEnumerable<HRManagement.Core.Entities.Leave>

<h2>My Leave Requests</h2>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Leave ID</th>
            <th>Employee ID</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Reason</th>
            <th>Status</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var leave in Model)
        {
            <tr>
                <td>@leave.LeaveId</td>
                <td>@leave.EmployeeId</td>
                <td>@leave.StartDate.ToShortDateString()</td>
                <td>@leave.EndDate.ToShortDateString()</td>
                <td>@leave.Reason</td>
                <td>@leave.Status</td>
            </tr>
        }

    </tbody>

</table>