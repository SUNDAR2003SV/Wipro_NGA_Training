@model IEnumerable<SecureShoppingApp.Models.Product>

<h2>Product List</h2>

<table border="1">

    <tr>
        <th>Product Name</th>
        <th>Price</th>
        <th>Description</th>
    </tr>

    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.Price</td>
            <td>@item.Description</td>
        </tr>
    }

</table>